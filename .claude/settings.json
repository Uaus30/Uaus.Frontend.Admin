{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(git:*)", "Bash(git *)"],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --delete:*)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --hard *)",
      "Bash(git clean:*)",
      "Bash(git clean *)",
      "Bash(git checkout --:*)",
      "Bash(git checkout -- *)",
      "Bash(git restore:*)",
      "Bash(git restore *)",
      "Bash(git rebase:*)",
      "Bash(git rebase *)",
      "Bash(git commit --amend:*)",
      "Bash(git commit --amend *)",
      "Bash(git add -A:*)",
      "Bash(git add -A *)",
      "Bash(git add -A)",
      "Bash(git add --all:*)",
      "Bash(git add --all *)",
      "Bash(git add --all)",
      "Bash(git add .)",
      "Bash(git branch -D:*)",
      "Bash(git branch -D *)"
    ]
  }
}
