{
  "name": "uaus-frontend-office",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/admin",
    "apps/pdv",
    "packages/api-client",
    "packages/receipt",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm run build:admin",
    "dev:admin": "npm run dev --workspace=@workspace/admin",
    "dev:pdv": "npm run dev --workspace=@workspace/pdv",
    "build:admin": "npm run build --workspace=@workspace/admin",
    "build:pdv": "npm run build --workspace=@workspace/pdv",
    "build:types": "tsc -b packages/api-client packages/receipt",
    "typecheck:admin": "npm run build:types && npm run typecheck --workspace=@workspace/admin",
    "typecheck:pdv": "npm run build:types && npm run typecheck --workspace=@workspace/pdv",
    "test:admin": "npm run test --workspace=@workspace/admin",
    "test:pdv": "npm run build:types && npm run test --workspace=@workspace/pdv",
    "test:receipt": "npm run test --workspace=@workspace/receipt",
    "test": "npm run test:admin && npm run test:pdv && npm run test:receipt"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
